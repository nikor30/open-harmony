diff --git a/libconcord/libconcord.cpp b/libconcord/libconcord.cpp
index 4e4e01d..afb5ccb 100644
--- a/libconcord/libconcord.cpp
+++ b/libconcord/libconcord.cpp
@@ -1471,6 +1471,11 @@ int read_firmware_from_remote(uint8_t **out, uint32_t *size, lc_callback cb,
                               void *cb_arg)
 {
     *size = FIRMWARE_MAX_SIZE;
+    /* local hack: allow a larger read-only dump, e.g. LC_FW_READ_SIZE=0x40000 */
