     debug("Net error: %s failed with error %s", msg, strerror(errno));
 #endif
 }
+
+/*
+ * local hack (open-harmony): raw flash access for write tests.
+ * Refuses every range outside [LC_RAW_MIN, LC_RAW_MAX): on the Harmony One
+ * the application sector 0x020000 and the unused sector 0x030000.
+ */
+#define LC_RAW_MIN 0x020000
+#define LC_RAW_MAX 0x040000
+
+static int _lc_raw_allowed(uint32_t addr, uint32_t len)
+{
+    return len > 0 && addr >= LC_RAW_MIN && addr < LC_RAW_MAX &&
+           len <= LC_RAW_MAX - addr;
+}
+
+extern "C" int lc_raw_read(uint32_t addr, uint32_t len, uint8_t *out)
+{
+    if (!rmt || !_lc_raw_allowed(addr, len)) {
+        return LC_ERROR;
+    }
+    return rmt->ReadFlash(addr, len, out, ri.protocol, false, NULL, NULL, 0);
+}
+
+extern "C" int lc_raw_erase_sector(uint32_t addr)
+{
+    if (!rmt || !_lc_raw_allowed(addr, 0x10000) || (addr & 0xFFFF)) {
+        return LC_ERROR;
+    }
+    return rmt->EraseFlash(addr, 0x10000, ri, NULL, NULL, 0);
+}
+
+extern "C" int lc_raw_write(uint32_t addr, uint32_t len, const uint8_t *data)
+{
+    if (!rmt || !_lc_raw_allowed(addr, len)) {
+        return LC_ERROR;
+    }
+    return rmt->WriteFlash(addr, len, data, ri.protocol, NULL, NULL, 0);
+}
+
+/*
+ * local hack (open-harmony): read one region of a usbnet (Z) remote such as
+ * the Harmony 900 into buf. Read-only; fails if the remote announces more
+ * than buf_len bytes.
+ */
+extern uint32_t lc_z_read_max;
+extern uint32_t lc_z_last_len;
+
+extern "C" int lc_z_read_region(uint8_t region, uint8_t *buf, uint32_t buf_len,
+                                uint32_t *len)
+{
+    if (!rmt || !rmt->IsZRemote() || !buf || !len) {
+        return LC_ERROR;
+    }
+    lc_z_read_max = buf_len;
+    lc_z_last_len = 0;
+    /* for Z remotes ReadFlash(addr) is ReadRegion(addr) */
+    int err = rmt->ReadFlash(region, buf_len, buf, ri.protocol, false, NULL,
+                             NULL, 0);
+    *len = lc_z_last_len;
+    lc_z_read_max = UINT32_MAX;
+    return err;
+}
+
+/*
+ * local hack (open-harmony): write one region of a usbnet (Z) remote with
+ * the same START/HEADER/DATA/DONE/CHECKSUM/FINISH sequence as a config
+ * update. Only region 12 (platform, a ZIP) is allowed.
+ */
+extern uint8_t lc_z_update_region;
+
+static void lc_z_no_progress(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t,
+                             void *, const uint32_t *)
+{
+}
+
+extern "C" int lc_z_write_region(uint8_t region, const uint8_t *data,
+                                 uint32_t len)
+{
+    if (!rmt || !rmt->IsZRemote() || !data || len == 0 || region != 12) {
+        return LC_ERROR;
+    }
+    lc_z_update_region = region;
+    int err = rmt->UpdateConfig(len, data, lc_z_no_progress, NULL, 0, 0,
+                                NULL);
+    lc_z_update_region = REGION_USER_CONFIG;
+    return err;
+}
